      "search_space_json": "{\"boundary_width_px\": [1.5, 2.0, 2.5], \"boundary_sensitivity\": [0.6, 0.8, 1.0], \"scratch_min_crossing_deg\": [12, 20, 30], \"scratch_min_length_px\": [300, 500, 700], \"min_area_px\": [30, 60, 100], \"bridge_gaps_px\": [5, 9, 13]}"
